# ==============================================================================
# PRESTIA MARKETPLACE - .gitignore
# ==============================================================================

# --- Dépendances ---
/node_modules/
/vendor/

# --- Environnements & Secrets (CRITIQUE : JAMAIS DANS GIT) ---
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
/auth.json

# --- Builds & Fichiers compilés ---
/public/build/
/public/hot
/public/storage
dist/
build/
.cache/

# --- Données privées & Stockage Laravel ---
/storage/*.key
/storage/pail
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/app/kyc_documents/*
!/storage/app/kyc_documents/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/inertia-devtools/

# --- Tests & Caches d'exécution ---
/.phpunit.cache/
.phpunit.result.cache
/bootstrap/ssr/
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
coverage/

# --- Fichiers de log NPM / Yarn / PNPM ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Système d'exploitation & IDE ---
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
/.fleet/
/.nova/
/.zed/
.phpactor.json
Homestead.json
Homestead.yaml

# --- Wayfinder & Artefacts générés ---
/public/fonts-manifest.dev.json
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder
